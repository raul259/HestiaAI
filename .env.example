# =====================================================
# VARIABLES DE ENTORNO - EJEMPLO
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env real a GitHub (ya está en .gitignore)
# =====================================================

# --- Base de datos (Supabase / PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- APIs externas ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
RESEND_API_KEY=re_tu_api_key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL local (Docker) ---
POSTGRES_DB=hestia_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_password

# --- pgAdmin (Docker) ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=cambia_esta_password
